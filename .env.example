# NutriTrack Environment Configuration
# ==============================================================================
# ZERO-COST & LOCAL-FIRST ARCHITECTURE:
# NutriTrack operates completely offline using browser IndexedDB / LocalStorage
# by default. You DO NOT need Firebase or any paid cloud account to run NutriTrack.
#
# If you wish to enable optional multi-device cloud synchronization via Google
# Firebase (Free Spark Tier), rename this file to .env and provide your project keys.
# ==============================================================================

# Firebase Client Web App Configuration (OPTIONAL)
# Obtain from: Firebase Console -> Project Settings -> General -> Your Apps (Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional: Set to "true" to connect to local Firebase Emulators (Auth on 9099, Firestore on 8080)
VITE_USE_FIREBASE_EMULATOR=false
