rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Foods Collection
    match /foods/{foodId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Recipes Collection
    match /recipes/{recipeId} {
      allow read: if isAuthenticated() && (
        resource.data.creatorUserId == request.auth.uid || 
        resource.data.isPublic == true
      );
      allow create: if isAuthenticated() && request.resource.data.creatorUserId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.creatorUserId == request.auth.uid;
    }

    // 4. Meal Plans Collection
    match /mealPlans/{planId} {
      allow read, write: if isAuthenticated() && (
        resource == null ? request.resource.data.userId == request.auth.uid : resource.data.userId == request.auth.uid
      );
    }

    // 5. Food Logs Collection
    match /foodLogs/{logId} {
      allow read, write: if isAuthenticated() && (
        resource == null ? request.resource.data.userId == request.auth.uid : resource.data.userId == request.auth.uid
      );
    }

    // 6. Weight Logs Collection
    match /weightLogs/{logId} {
      allow read, write: if isAuthenticated() && (
        resource == null ? request.resource.data.userId == request.auth.uid : resource.data.userId == request.auth.uid
      );
    }

    // 7. Shopping Lists Collection
    match /shoppingLists/{listId} {
      allow read, write: if isAuthenticated() && (
        resource == null ? request.resource.data.userId == request.auth.uid : resource.data.userId == request.auth.uid
      );
    }

    // 8. Activity Logs Collection (CMF Watch 3 Pro & Health Connect data)
    // Ensures users can only access their own activity logs. Validates incoming schema.
    match /activityLogs/{logId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create, update: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.date is string &&
        request.resource.data.metricType in ['steps', 'active_calories', 'distance_meters', 'workout_duration_minutes', 'exercise_session'] &&
        request.resource.data.value is number &&
        request.resource.data.value >= 0;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 9. Wearable Connections Collection (Connection state & permissions)
    match /wearableConnections/{connectionId} {
      allow read, write: if isAuthenticated() && (
        resource == null ? request.resource.data.userId == request.auth.uid : resource.data.userId == request.auth.uid
      );
    }
  }
}
